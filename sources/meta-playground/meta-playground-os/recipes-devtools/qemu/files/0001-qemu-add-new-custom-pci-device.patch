From: Abhishek Ojha <abhishek.ojha@savoirfairelinux.com>
Date: Sun, 16 Nov 2025 16:42:58 -0500
Subject: [PATCH] test

---
 hw/pci/doby.c         | 93 +++++++++++++++++++++++++++++++++++++++++++
 hw/pci/meson.build    |  1 +
 include/hw/pci/doby.h | 10 +++++
 3 files changed, 104 insertions(+)
 create mode 100644 hw/pci/doby.c
 create mode 100644 include/hw/pci/doby.h

diff --git a/hw/pci/doby.c b/hw/pci/doby.c
new file mode 100644
index 000000000..53ea0e1aa
--- /dev/null
+++ b/hw/pci/doby.c
@@ -0,0 +1,93 @@
+#include "qemu/osdep.h"
+#include "hw/pci/pci.h"
+#include "hw/pci/pci_device.h"
+#include "hw/pci/doby.h"
+#include "hw/qdev-properties.h"
+#include "qapi/error.h"
+
+typedef struct DobyState {
+    PCIDevice parent_obj;
+    MemoryRegion mmio;
+    uint32_t data_reg;
+} DobyState;
+
+static void doby_register_types(void);
+static void doby_instance_init(Object *obj);
+static void doby_class_init(ObjectClass *klass, void *data);
+static uint64_t doby_mmio_read(void *opaque, hwaddr addr, unsigned size);
+static void doby_mmio_write(void *opaque, hwaddr addr, uint64_t val, unsigned size);
+static void pci_doby_realize(PCIDevice *pdev, Error **errp);
+static void pci_doby_uninit(PCIDevice *pdev);
+
+static void doby_register_types(void)
+{
+    static InterfaceInfo interfaces[] = {
+        { INTERFACE_CONVENTIONAL_PCI_DEVICE },
+        { },
+    };
+    static const TypeInfo doby_type_info = {
+        .name = TYPE_DOBY,
+        .parent = TYPE_PCI_DEVICE,
+        .instance_size = sizeof(DobyState),
+        .instance_init = doby_instance_init,
+        .class_init    = doby_class_init,
+        .interfaces = interfaces,
+    };
+    type_register_static(&doby_type_info);
+}
+
+type_init(doby_register_types);
+
+static void doby_instance_init(Object *obj)
+{
+    printf("Doby instance init\n");
+}
+
+static void doby_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    k->realize = pci_doby_realize;
+    k->exit = pci_doby_uninit;
+    k->vendor_id = PCI_VENDOR_ID_QEMU;
+    k->device_id = 0x5678;
+    k->revision = 0x01;
+    k->class_id = PCI_CLASS_OTHERS;
+}
+
+static uint64_t doby_mmio_read(void *opaque, hwaddr addr, unsigned size)
+{
+    DobyState *s = DO_BY(opaque);
+    printf("Reading 0x%x\n", s->data_reg);
+    return s->data_reg;
+}
+
+static void doby_mmio_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    DobyState *s = DO_BY(opaque);
+    printf("Writing 0x%x\n", s->data_reg);
+    s->data_reg = val;
+}
+
+static const MemoryRegionOps doby_mmio_ops = {
+    .read = doby_mmio_read,
+    .write = doby_mmio_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void pci_doby_realize(PCIDevice *pdev, Error **errp)
+{
+    DobyState *s = DO_BY(pdev);
+    memory_region_init_io(&s->mmio, OBJECT(s), &doby_mmio_ops, s, "doby-mmio", 0x1000);
+    pci_register_bar(pdev, 0, PCI_BASE_ADDRESS_SPACE_MEMORY, &s->mmio);
+}
+
+static void pci_doby_uninit(PCIDevice *pdev)
+{
+    printf("Doby un-init\n");
+}
+
diff --git a/hw/pci/meson.build b/hw/pci/meson.build
index b9c34b2ac..65031b30c 100644
--- a/hw/pci/meson.build
+++ b/hw/pci/meson.build
@@ -16,6 +16,7 @@ pci_ss.add(files(
 # CONFIG_PCI_EXPRESS=n.
 pci_ss.add(files('pcie.c', 'pcie_aer.c'))
 pci_ss.add(files('pcie_doe.c'))
+pci_ss.add(files('doby.c'))
 system_ss.add(when: 'CONFIG_PCI_EXPRESS', if_true: files('pcie_port.c', 'pcie_host.c'))
 system_ss.add_all(when: 'CONFIG_PCI', if_true: pci_ss)
 
diff --git a/include/hw/pci/doby.h b/include/hw/pci/doby.h
new file mode 100644
index 000000000..b3b175913
--- /dev/null
+++ b/include/hw/pci/doby.h
@@ -0,0 +1,10 @@
+#ifndef QEMU_HW_PCI_DOBY_H
+#define QEMU_HW_PCI_DOBY_H
+
+#include "hw/pci/pci.h"
+
+#define TYPE_DOBY "doby-pci-dev"
+#define DO_BY(obj) OBJECT_CHECK(DobyState, (obj), TYPE_DOBY)
+
+typedef struct DobyState DobyState;
+#endif /* QEMU_HW_PCI_DOBY_H */
-- 
2.34.1

